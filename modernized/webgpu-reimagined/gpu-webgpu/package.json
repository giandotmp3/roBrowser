{
	"name": "@robrowser-webgpu/gpu-webgpu",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "gpu-webgpu backend of the reimagined renderer: device, MSAA offscreen target + blit, precompiled pipelines, texture-array residency, world, sprite runs, effects, GR2, post chain, live previews, capture, device-loss rebuild with WebGL2 fallback. Consumes render-records; owns no rendering rules beyond the GPU side.",
	"main": "src/index.js",
	"exports": {
		".": "./src/index.js"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"smoke:parity": "node smoke/run-parity.mjs",
		"smoke:parity:aa": "node smoke/run-parity.mjs --aa --max-diff-pct=0.05",
		"smoke:parity:entities": "node smoke/run-parity.mjs --page=entities --max-diff-pct=0.05",
		"smoke:parity:entities:aa": "node smoke/run-parity.mjs --page=entities --aa --max-diff-pct=0.1",
		"smoke:parity:post": "node smoke/run-parity.mjs --page=post --max-diff-pct=0.05",
		"smoke:parity:effects": "node smoke/run-parity.mjs --page=effects --max-diff-pct=0.05",
		"smoke:parity:effects:aa": "node smoke/run-parity.mjs --page=effects --aa --max-diff-pct=0.05",
		"smoke:parity:effects2": "node smoke/run-parity.mjs --page=effects2 --max-diff-pct=0.05",
		"smoke:parity:effects2:aa": "node smoke/run-parity.mjs --page=effects2 --aa --max-diff-pct=0.1",
		"smoke:parity:backend": "node smoke/run-parity.mjs --page=backend --max-diff-pct=0.05"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"playwright": "^1.56.1",
		"vite": "^8.3.4",
		"vitest": "^4.1.2"
	}
}
