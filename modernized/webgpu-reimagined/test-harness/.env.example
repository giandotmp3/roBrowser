# test-harness runtime configuration. Placeholders only: copy to .env and fill locally.
# No value here comes from legacy code, and none of these are credentials.

# Which subject the acceptance suite drives. Unset = NotImplementedSubject (all rules pending).
#   modern  -> render-records + scene (+ backend fragment probe), via HARNESS_SUBJECT_MODULE
#   legacy  -> legacy renderer instrumented by the record shim, via HARNESS_SUBJECT_MODULE
HARNESS_SUBJECT=${HARNESS_SUBJECT}
# Absolute path or URL of an ES module exporting createSubject({ rng, clock }).
HARNESS_SUBJECT_MODULE=${HARNESS_SUBJECT_MODULE}
# Reference subject for the record-diff parity suite (normally the legacy shim adapter).
HARNESS_REFERENCE_MODULE=${HARNESS_REFERENCE_MODULE}

# Smoke goldens (Playwright): page that exposes window.__harness, and GRF asset root.
HARNESS_SMOKE_URL=${HARNESS_SMOKE_URL}
HARNESS_ASSET_ROOT=${HARNESS_ASSET_ROOT}
# Set to 1 to (re)write golden PNGs instead of comparing.
HARNESS_UPDATE_GOLDENS=0
